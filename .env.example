# ==============================================================================
# Stocktics Environment Configuration Template
# Copy to `.env` in the project root and fill in real values. `.env` is gitignored.
# The Android build (app/build.gradle.kts) also reads the SUPABASE_* values from here.
# ==============================================================================

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# INDstocks / INDmoney
INDSTOCKS_API_TOKEN=your_indstocks_access_token_here
INDSTOCKS_BASE_URL=https://api.indstocks.com
INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
INDMONEY_CLIENT_ID=your_indmoney_client_id
INDMONEY_CLIENT_SECRET=your_indmoney_client_secret
INDMONEY_REDIRECT_URI=http://127.0.0.1:8000/api/indmoney/callback

# AI Research Agent (optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
